# Server
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:8080

# MongoDB
MONGO_URI=mongodb+srv://<user>:<pass>@cluster.mongodb.net/threadlink

# JWT
JWT_SECRET=your_64_char_random_secret_here
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Google OAuth (for Login with Google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Gmail API (separate OAuth for Gmail operations)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:5000/api/email/oauth/callback

# File Upload
UPLOAD_DIR=uploads/
MAX_FILE_SIZE_MB=5

# Rate Limiting
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
GENERAL_RATE_LIMIT_MAX=100
